; ============================================================================
; Exemple 03 : Classes et Methodes Abstraites
; ============================================================================

Abstract Class Vehicule
  Protected marque.s

  Public Method Init(marque_p.s)
    This\marque = marque_p
  EndMethod

  Public Abstract Method Demarrer()
  Public Abstract Method.s GetType()
EndClass

Class Voiture Extends Vehicule
  Public Method Demarrer()
    PrintN(This\marque + " (" + This\GetType() + ") : Vroom ! Le moteur demarre.")
  EndMethod

  Public Method.s GetType()
    ProcedureReturn "Voiture Thermique"
  EndMethod
EndClass

OpenConsole()
PrintN("=== Demonstration PureBasic OOP : Classes Abstraites ===")
PrintN("")

Define *v.Vehicule = New Voiture("Peugeot 208")
*v\Demarrer()

PrintN("")
PrintN("Appuyez sur Entree pour quitter...")
Input()
CloseConsole()