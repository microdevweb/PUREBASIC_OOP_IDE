<Window Title="PureBasic OOP - Simple MVVM Test" Width="520" Height="340">
  <DockPanel LastChildFill="true">
    <StackPanel Dock="Top" Orientation="Vertical" Margin="15,12,15,5">
      <Label Text="PureBasic OOP - MVVM DataBinding Test" Height="24"/>
    </StackPanel>
    
    <StackPanel Dock="Bottom" Orientation="Horizontal" Margin="15,5" Height="26">
      <Label Text="{Binding StatusText}" Width="480" Height="20"/>
    </StackPanel>
    
    <StackPanel Dock="Fill" Orientation="Vertical" Spacing="10" Margin="15,10">
      <Label Text="Click any button to trigger a ViewModel command:" Height="20"/>
      <StackPanel Orientation="Horizontal" Spacing="10" Height="36">
        <Button Text="Button 1" Click="ClickBtn1" Width="100" Height="32"/>
        <Button Text="Button 2" Click="ClickBtn2" Width="100" Height="32"/>
        <Button Text="Button 3" Click="ClickBtn3" Width="100" Height="32"/>
        <Button Text="Reset"    Click="Reset"     Width="80"  Height="32"/>
      </StackPanel>
      
      <Label Text="ViewModel Output (OneWay DataBinding):" Margin="0,5,0,0" Height="20"/>
      <TextBox Text="{Binding ClickMessage}" Height="28"/>
      
      <Label Text="{Binding TotalClicksText}" Margin="0,5,0,0" Height="22"/>
    </StackPanel>
  </DockPanel>
</Window>

