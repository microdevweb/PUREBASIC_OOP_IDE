; ============================================================================
; Exemple 02 : Multi-fichiers et Namespaces Imbriques
; ============================================================================

XIncludeFile "geometry/Shape.pbo"
XIncludeFile "geometry/Circle.pbo"

Using Math::Geometry

OpenConsole()
PrintN("=== Demonstration PureBasic OOP : Namespaces & Multi-Fichiers ===")
PrintN("")

Define *c.Shape = New Circle("Cercle Solaire", 5.0)
*c\Afficher()

PrintN("")
PrintN("Appuyez sur Entree pour quitter...")
Input()
CloseConsole()